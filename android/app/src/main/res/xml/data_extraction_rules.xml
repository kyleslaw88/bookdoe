<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: no cloud backup and no device-to-device transfer
     of the credential store, the server list or downloads (Android 12+;
     allowBackup="false" covers older versions). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
