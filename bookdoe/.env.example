# Application settings for the bookdoe container (docker-compose.yml loads this
# file as env_file). install.sh writes a minimal version with a generated secret key;
# the setup wizard writes further values to /config/setup.env inside the volume.
# Precedence: real environment > this file > /config/setup.env > secrets backend.
# See docs/SECRETS.md for references such as infisical://NAME and file:///run/secrets/x.

# Required in production. Generate with: openssl rand -hex 32
# Left empty, the container generates one into /config/setup.env on first start.
BOOKDOE_SECRET_KEY=change-me-to-a-long-random-secret
BOOKDOE_LOG_LEVEL=INFO

# auth: local | oidc | proxy | none
BOOKDOE_AUTH_MODE=local
# Optional one-shot bootstrap. If blank, the first-run wizard at /setup creates the
# initial administrator.
BOOKDOE_BOOTSTRAP_USER=admin
BOOKDOE_BOOTSTRAP_PASSWORD=

# Secrets backend: env (default) | infisical. Infisical needs the INFISICAL_* values.
BOOKDOE_SECRETS_BACKEND=env
#INFISICAL_SITE_URL=https://app.infisical.com
#INFISICAL_CLIENT_ID=
#INFISICAL_CLIENT_SECRET=
#INFISICAL_PROJECT_ID=
#INFISICAL_ENVIRONMENT=prod
#INFISICAL_SECRET_PATH=/

# Native OIDC example (Authentik, Keycloak, Authelia and similar)
#BOOKDOE_OIDC_ISSUER=https://auth.example.com/application/o/bookdoe/
#BOOKDOE_OIDC_CLIENT_ID=
#BOOKDOE_OIDC_CLIENT_SECRET=
#BOOKDOE_OIDC_SCOPES=openid profile email
#BOOKDOE_OIDC_ALLOWED_GROUPS=
#BOOKDOE_OIDC_BOOTSTRAP_ADMINS=

# Only used with BOOKDOE_AUTH_MODE=proxy
#BOOKDOE_PROXY_USER_HEADER=X-authentik-username
#BOOKDOE_PROXY_EMAIL_HEADER=X-authentik-email
#BOOKDOE_TRUSTED_PROXIES=172.18.0.0/16

# OpenReads companion service (the compose network name; override only if remote)
#OPENREADS_URL=http://openreads:8790
OPENREADS_API_KEY=

# Optional metadata provider keys (higher rate limits; everything works without them)
BOOKDOE_GOOGLE_BOOKS_API_KEY=
BOOKDOE_HARDCOVER_API_KEY=
BOOKDOE_AUDIOBOOKDB_API_KEY=

# Optional OpenAI-compatible LLM for kids-tag suggestions and recommendations
BOOKDOE_LLM_ENABLED=0
#BOOKDOE_LLM_BASE_URL=http://host.docker.internal:8000/v1
#BOOKDOE_LLM_API_KEY=
#BOOKDOE_LLM_MODEL=

BOOKDOE_SCHEDULER_ENABLED=1
BOOKDOE_FULL_HASH_MAX_MB=64

# Online SQLite backups: SQLite backup API, integrity check, SHA-256 manifests, rotation.
BOOKDOE_BACKUP_DIR=/config/backups
BOOKDOE_BACKUP_RETENTION=14
