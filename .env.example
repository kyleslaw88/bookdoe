# Host-side settings for docker-compose.yml. Copy to .env (install.sh does this for
# you). Paths are on the Docker host; relative paths are relative to this file.
# Application settings (secret key, auth, API keys) live in bookdoe/.env and
# openreads/.env, or in the config volume once the setup wizard has run.

# Port published on the host; container port is always 8787.
BOOKDOE_PORT=8795
# How browsers and the mobile app reach the server (used in sign-in and pairing links).
BOOKDOE_PUBLIC_URL=http://localhost:8795
# Serve /docs and /openapi.json (1/0). Unset: on for http, off when BOOKDOE_PUBLIC_URL is https.
# BOOKDOE_API_DOCS=0

# Config and databases
BOOKDOE_CONFIG_DIR=./data/bookdoe
OPENREADS_DATA_DIR=./data/openreads

# Existing libraries, mounted read-only (adopt in place, nothing is moved)
BOOKS_DIR=./data/books
AUDIOBOOKS_DIR=./data/audiobooks
# Download client completed folder (read-only)
DOWNLOADS_DIR=./data/downloads
# Readarr database snapshots for the one-time migration (optional, read-only)
MIGRATIONS_DIR=./data/migrations
# Managed-import destinations: the only writable media paths
LIBRARY_EBOOKS_DIR=./data/library/ebooks
LIBRARY_AUDIOBOOKS_DIR=./data/library/audiobooks

# Identity the containers run as (must be able to read the libraries)
PUID=1000
PGID=1000
UMASK=002

# Optional: image names and container names (defaults shown)
#BOOKDOE_IMAGE=bookdoe:local
#OPENREADS_IMAGE=openreads:local
#BOOKDOE_CONTAINER_NAME=bookdoe
#OPENREADS_CONTAINER_NAME=openreads
#COMPOSE_PROJECT_NAME=bookdoe
