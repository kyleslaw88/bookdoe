GOOGLE_BOOKS_API_KEY=

# Native OpenReads v2 API (optional; leave blank on a private Docker network)
OPENREADS_V2_API_KEY=

# Optional OpenAI-compatible reconciliation model. The LLM is never an authority
# for identifiers or bibliographic facts; it only helps resolve ambiguity.
OPENREADS_LLM_ENABLED=0
OPENREADS_LLM_BASE_URL=http://host.docker.internal:8000/v1
OPENREADS_LLM_API_KEY=
OPENREADS_LLM_MODEL=
OPENREADS_LLM_TIMEOUT=45
PUID=99
PGID=100
UMASK=002
